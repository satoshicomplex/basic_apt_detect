CUE_WEIGHTS: Dict[str, float] = {
    "weapon_indicated": 0.30, "impact_or_struggle_sound": 0.25, "rapid_aggressive_motion": 0.20,
    "cornering_a_person": 0.20, "raised_aggressive_voice": 0.15, "victim_distress_biometrics": 0.15,
    "call_for_help": 0.15,
}


class Level(str, Enum):
    NONE = "NO ATTACK"
    POSSIBLE = "POSSIBLE: watch + pre-stage, do not deploy"
    IMMINENT = "IMMINENT: attack about to happen"
    ONGOING = "ONGOING: attack happening now"


def assess(cues: Dict[str, float], phase: str = "imminent") -> Tuple[Level, float, List[str]]:
    """Weighs the cues the IoTs report (each clamped 0-1) into a threat level."""
    clamped = {k: max(0.0, min(1.0, float(cues.get(k, 0.0)))) for k in CUE_WEIGHTS}
    confidence = min(1.0, sum(CUE_WEIGHTS[k] * clamped[k] for k in CUE_WEIGHTS))
    triggered = sorted((k for k, v in clamped.items() if v >= 0.5), key=lambda k: -CUE_WEIGHTS[k])
    if confidence < CONF_NONE:
        level = Level.NONE
    elif confidence < CONF_POSSIBLE:
        level = Level.POSSIBLE
    else:
        level = Level.ONGOING if phase == "ongoing" else Level.IMMINENT
    return level, round(confidence, 3), triggered


# ===========================================================================
# 3 · SCENE + RED LINE   (see the COORDINATE CONTRACT at the top)
