def _victim_prompt(victim: Actor, scene: Scene) -> Dict[str, Any]:
    """Pick the cue most likely to prompt life-saving MOVEMENT, from the victim's
    own biometrics, pointing them to the exit furthest from every aggressor."""
    aggr = scene.aggressors
    exits = sorted(scene.safe_exits, key=lambda e: -min((_angle(e, a.where) for a in aggr), default=180.0))
    heading = exits[0] if exits else None
    bio = victim.biometrics
    frozen = bio.get("hrv_ms", 99) < 20 or bio.get("cortisol_z", 0) >= 2.5 or bio.get("hr", 0) > 150
    modality = ("multi-cue: loud 'RUN', bright directional light, floor buzz toward the exit"
                if frozen else "voice: a clear 'RUN' + direction")
    return {"target_id": victim.id, "type": "VICTIM_EVASION_ALERT", "message": "RUN",
            "exit_vector": heading, "modality": modality,
            "note": "prompts protective movement; directs the victim AWAY from the aggressor"}


def _deter(aggressor: Actor, scene: Scene,
           emitter: Tuple[float, float, float] = (0.0, 0.0, 0.0)) -> Dict[str, Any]:
    """Aggressor-facing: a loud attention alarm + strobe lights that deter, draw
    witnesses and summon help. NOT an incapacitation signal. If a directed alarm
    is red-lined, fall back to an AREA alarm only when no responder is on scene."""
    safe, blocked = red_line_ok(aggressor.where, scene, emitter)
    if safe:
        return {"target_id": aggressor.id, "type": "DIRECTIONAL_ATTENTION_ALARM",
                "modality": "high-visibility strobe + audible alarm", "aim_vector": aggressor.where,
                "bounded": "loud + attention-drawing; NOT designed to incapacitate or injure",
                "purpose": "deter and summon witnesses"}
    area_ok, _ = red_line_ok(None, scene)
    result = {"target_id": aggressor.id, "type": "WITHHELD_RED_LINE",
              "reason": f"would endanger protected personnel: {', '.join(blocked)}"}
    if area_ok:
        result["fallback"] = "AREA_ATTENTION_ALARM"
        result["area_alarm"] = {"type": "AREA_ATTENTION_ALARM",
                                "modality": "omnidirectional strobe + audible alarm",
                                "bounded": "loud + attention-drawing; NOT designed to incapacitate or injure"}
        logger.info("red-line withhold + area fallback aggressor=%s", aggressor.id)
    else:
        result["fallback"] = "none (responder on scene)"
        logger.warning("red-line withhold (no area) aggressor=%s blocked=%s", aggressor.id, blocked)
    return result


SUMMON = ["call law enforcement / 911", "alert nearby people", "turn on all cameras + recording"]


def plan(level: Level, scene: Scene, deploy_now: bool,
         emitter: Tuple[float, float, float] = (0.0, 0.0, 0.0)) -> Dict[str, Any]:
    """Only the measures that are needed, timely and safe. Summoning help and
    recording run even while pre-staging; the active measures wait for the
    window. `emitter` is the acting IoT's position for the red-line geometry."""
    actions: Dict[str, Any] = {"summon_help": SUMMON, "notify_law_enforcement": True, "record": True}
    if not deploy_now:
        return {"stage": "PRE-STAGE", "measures": actions}
    actions["victim_alerts"] = [_victim_prompt(v, scene) for v in scene.victims]
    actions["deter"] = [_deter(a, scene, emitter) for a in scene.aggressors]
    return {"stage": "DEPLOY", "measures": actions}


