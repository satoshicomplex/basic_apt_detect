def search_distant_rf(distant_peers: List[Dict[str, Any]]) -> List[str]:
    """Frequency / RF signals travel at light speed, so a MORE DISTANT IoT can
    still deploy the needed signal in time when nothing is in range. Runs
    sub-second in parallel; returns the reachable RF-capable peers (distance
    barely costs time at light speed), nearest first as a tiebreak."""
    rf = [p for p in distant_peers
          if p.get("channel") and ({"frequency", "rf"} & {c.lower() for c in p.get("can", [])})]
    return [p["name"] for p in sorted(rf, key=lambda p: p.get("distance_m", 0.0))]


def capable(scene: Scene, willing_iots: List[str], requester_can_act: bool = False,
            distant_rf: Optional[List[str]] = None) -> Tuple[bool, str, str]:
    """We can act if there is a victim AND one of, in order of preference:
    a willing IoT in range · the requesting IoT doing it itself · a distant
    RF/frequency IoT that can deploy at light speed. Returns (ok, path, why)."""
    if not scene.victims:
        return False, "", "no victim identified"
    if willing_iots:
        return True, "willing IoT in range", "ok"
    if requester_can_act:
        return True, "through the requesting IoT itself", "no IoT in range; the requester will act"
    if distant_rf:
        return True, f"distant RF IoT at light speed ({distant_rf[0]})", "no IoT in range; using a distant RF peer"
    return False, "", "no willing IoT in range, requester can't act, no distant RF peer"


def cyber_scan(iot_id: str, telemetry: Dict[str, Any]) -> Dict[str, Any]:
    """Satoshi Complex, in parallel: is a cyber-physical attack spoofing, jamming
    or tampering with the sensors to worsen or mask the violence?"""
    packet_loss = float(telemetry.get("packet_loss", 0.0))
    clock_skew_ms = abs(float(telemetry.get("clock_skew_ms", 0.0)))
    jam_db = float(telemetry.get("rf_noise_db", 0.0))
    compromised = (packet_loss > PACKET_LOSS_THRESH or clock_skew_ms > CLOCK_SKEW_MS_THRESH
                   or jam_db > RF_NOISE_DB_THRESH)
    if compromised:
        logger.warning("cyber-scan compromised iot=%s loss=%.2f skew=%.1f jam=%.1f",
                       iot_id, packet_loss, clock_skew_ms, jam_db)
    return {"verified": not compromised, "packet_loss": packet_loss, "clock_skew_ms": clock_skew_ms,
            "rf_noise_db": jam_db,
            "note": "sensors look tampered: weigh cues with caution" if compromised else "sensors verified"}


def handoff(from_iot: str, to: Any, is_emergency: bool, reason: str) -> Dict[str, Any]:
    """Sub-second hand-off: another App that can defend, a peer IoT, or dispatch. Zero charge."""
    target = to or "DISPATCH_GATEWAY"
    logger.warning("handoff from=%s to=%s emergency=%s reason=%s", from_iot, target, is_emergency, reason)
    return {"handoff_triggered": True, "from_iot": from_iot, "to": target,
            "priority": "CRITICAL_EMERGENCY" if is_emergency else "ELEVATED",
            "notice": (f"HAND-OFF from {from_iot}: "
                       f"{'this IS / may be an emergency' if is_emergency else 'unverified'} - {reason}"),
            "billed_units": 0}


def pick_defender(other_apps: List[Dict[str, Any]]) -> Optional[str]:
    for app in other_apps or []:
        if app.get("can_defend"):
            return app["name"]
    return None


LAW_BLOCKED = {"raw_audio", "raw_video", "raw_biometrics", "health", "name", "address",
               "exact_location", "faces"}


def report(iot_id: str, level: Level, confidence: float, cues: List[str],
           stage: str, cyber: Dict[str, Any], extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    """A minimized, lawful record for CISA / the appropriate defense office."""
    pkt = {"recipient": "CISA / appropriate defense office",
           "timestamp_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
           "source_iot": iot_id, "threat_level": level.value, "confidence": confidence,
           "cues_detected": cues, "stage": stage, "cyber_integrity_ok": cyber.get("verified", False),
           "pii_stripped": True}
    pkt.update({k: v for k, v in (extra or {}).items() if k not in LAW_BLOCKED})
    return pkt


def _validate(req: Dict[str, Any], scene: Scene) -> Optional[str]:
    """Reject malformed input before acting. Returns an error string or None."""
    for actor in scene.actors:
        if not all(math.isfinite(x) for x in actor.where):
            return f"non-finite coordinate on actor {actor.id}"
    for ex in scene.safe_exits:
        if not all(math.isfinite(x) for x in ex):
            return "non-finite exit coordinate"
    sth = req.get("seconds_to_harm")
    if sth is not None and (not isinstance(sth, (int, float)) or sth < 0):
        return "seconds_to_harm must be >= 0"
    if not all(isinstance(v, (int, float)) for v in (req.get("cues") or {}).values()):
        return "all cue values must be numeric"
    return None


# ===========================================================================
# 7 · MAIN ORCHESTRATOR: one sub-second entry point
# ===========================================================================
def respond(acct: Account, req: Dict[str, Any], scene: Scene,
            executor: Optional[ThreadPoolExecutor] = None,
            handoff_hook: Optional[Callable[[Dict[str, Any]], None]] = None) -> Dict[str, Any]:
    t0 = time.perf_counter()
    ms = lambda: round((time.perf_counter() - t0) * 1000, 2)
    is_emergency = bool(req.get("emergency", False))

    err = _validate(req, scene)
    if err:
        logger.error("validation failed iot=%s: %s", acct.iot_id, err)
        ho = handoff(acct.iot_id, None, is_emergency, f"validation: {err}")
        if handoff_hook:
            handoff_hook(ho)
        return {"status": "HANDOFF", "handoff": ho, "latency_ms": ms()}

    receipt, status, authorized = admit(acct, req)
    if not authorized:
        return {"status": status, "receipt": receipt, "latency_ms": ms()}

    # dead-man's switch: contact with the requesting IoT dropped
    if req.get("link_lost"):
        ho = handoff(acct.iot_id, (req.get("nearby_iots") or [None])[0], is_emergency,
                     "primary IoT heartbeat lost")
        if handoff_hook:
            handoff_hook(ho)
        return {"status": "HANDOFF", "handoff": ho, "latency_ms": ms()}

    # can we help? a willing IoT in range, OR the requesting IoT itself, OR -
    # searched sub-second in parallel - a distant RF/frequency IoT that deploys
    # at light speed. Only if none can act do we hand off; IoT is NOT charged.
    distant_rf = search_distant_rf(req.get("distant_peers", []))
    can, deploy_path, why = capable(scene, req.get("willing_iots", []),
                                    req.get("requester_can_act", False), distant_rf)
    if not can:
        ho = handoff(acct.iot_id, pick_defender(req.get("other_apps", [])), is_emergency, why)
        acct.settle(0, 0, succeeded=False, is_emergency=is_emergency)
        return {"status": "HANDOFF" if ho["to"] != "DISPATCH_GATEWAY" else "CANNOT_HELP",
                "reason": why, "handoff": ho, "latency_ms": ms()}

    own_pool = executor is None
    pool = executor or ThreadPoolExecutor(max_workers=2)
    try:
        cyber_future = pool.submit(cyber_scan, acct.iot_id, req.get("telemetry", {}))
        level, confidence, triggered = assess(req.get("cues", {}), req.get("phase", "imminent"))
        cyber = cyber_future.result(timeout=0.25)
        if not cyber.get("verified", True):                   # tampered sensors -> trust the cues less
            confidence = round(confidence * CYBER_CONF_SCALE, 3)
            logger.info("confidence scaled by cyber integrity -> %.3f", confidence)
        if level in (Level.IMMINENT, Level.ONGOING):
            is_emergency = True
        deploy_now, timing_reason, escalate = threat_time(level, req.get("seconds_to_harm"))
        emitter = tuple(req.get("emitter", (0.0, 0.0, 0.0)))
        planned = plan(level, scene, deploy_now, emitter) if level != Level.NONE else {"stage": "NONE", "measures": {}}
    except Exception as exc:                                  # timeout / error -> hand off, not charged
        logger.exception("execution fallback iot=%s", acct.iot_id)
        ho = handoff(acct.iot_id, pick_defender(req.get("other_apps", [])), is_emergency,
                     f"execution fallback: {type(exc).__name__}: {exc}")
        if handoff_hook:
            handoff_hook(ho)
        return {"status": "HANDOFF", "handoff": ho, "latency_ms": ms()}
    finally:
        if own_pool:
            pool.shutdown(wait=False)

    incident = (report(acct.iot_id, level, confidence, triggered, planned["stage"], cyber,
                       {"phase": req.get("phase", "imminent"), "escalate_dispatch": escalate})
                if level != Level.NONE else None)
    succeeded = level != Level.NONE
    billed = acct.settle(int(req.get("data_units", 10)), int(req.get("nn_units", 25)), succeeded, is_emergency)
    logger.info("respond complete iot=%s level=%s path=%s deploy=%s billed=%d latency=%.1fms",
                acct.iot_id, level.value, deploy_path, deploy_now, billed, ms())

    return {"status": "OK", "receipt": receipt, "deploy_path": deploy_path,
            "threat": {"level": level.value, "confidence": confidence, "cues": triggered},
            "timing": {"deploy": deploy_now, "reason": timing_reason, "escalate_dispatch": escalate},
            "plan": planned, "cyber_scan": cyber, "report": incident,
            "billed_units": billed, "latency_ms": ms()}


