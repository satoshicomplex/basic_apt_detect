class Role(str, Enum):
    VICTIM = "victim / would-be victim"
    AGGRESSOR = "aggressor"
    RESPONDER = "law enforcement / responder"          # red-line protected
    BYSTANDER = "bystander"


@dataclass
class Actor:
    id: str
    role: Role
    where: Tuple[float, float, float]
    biometrics: Dict[str, float] = field(default_factory=dict)   # victim only


@dataclass
class Scene:
    actors: List[Actor]
    safe_exits: List[Tuple[float, float, float]] = field(default_factory=list)

    def by_role(self, role: Role) -> List[Actor]:
        return [a for a in self.actors if a.role == role]

    @property
    def victims(self) -> List[Actor]:
        return self.by_role(Role.VICTIM)

    @property
    def aggressors(self) -> List[Actor]:
        return self.by_role(Role.AGGRESSOR)

    @property
    def protected(self) -> List[Actor]:
        return self.by_role(Role.RESPONDER) + self.by_role(Role.BYSTANDER)

    @property
    def has_responder(self) -> bool:
        return any(a.role == Role.RESPONDER for a in self.actors)


def red_line_ok(aim: Optional[Tuple[float, float, float]], scene: Scene,
                emitter: Tuple[float, float, float] = (0.0, 0.0, 0.0)) -> Tuple[bool, List[str]]:
    """A directional measure needs >= RED_LINE_DEG clearance from every responder
    and bystander, measured AT THE EMITTER. An area measure (aim=None) is blocked
    if any responder is on scene. With emitter at the origin the directional
    check reduces to _angle(aim, person) (see the COORDINATE CONTRACT)."""
    if aim is None:
        responders = [r.id for r in scene.by_role(Role.RESPONDER)]
        return len(responders) == 0, responders
    too_close = [p.id for p in scene.protected if _angle_from(emitter, aim, p.where) < RED_LINE_DEG]
    return len(too_close) == 0, too_close


