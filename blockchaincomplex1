# 4 · TIMING
# ===========================================================================
def threat_time(level: Level, seconds_to_harm: Optional[float]) -> Tuple[bool, str, bool]:
    """Returns (deploy_now, reason, escalate_dispatch)."""
    if level in (Level.NONE, Level.POSSIBLE):
        return False, "HOLD: below the deployment threshold; pre-stage only", False
    if seconds_to_harm is not None and seconds_to_harm < TOO_LATE_S:
        return False, "TOO LATE: impact within 150 ms; escalate to emergency dispatch", True
    if seconds_to_harm is not None and seconds_to_harm > TOO_EARLY_S and level != Level.ONGOING:
        return False, f"WAIT: {seconds_to_harm:.0f}s out; pre-stage and re-check the trajectory", False
    return True, "DEPLOY NOW: inside the window where it is needed and still works", False


