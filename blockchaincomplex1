RED_LINE_DEG = 35.0
CONF_NONE = 0.35
CONF_POSSIBLE = 0.60
TOO_LATE_S = 0.15
TOO_EARLY_S = 12.0
CYBER_CONF_SCALE = 0.65          # scale confidence when the sensors look compromised
PACKET_LOSS_THRESH = 0.40
CLOCK_SKEW_MS_THRESH = 250.0
RF_NOISE_DB_THRESH = 20.0

try:
    import numpy as np

    def _unit(v: Tuple[float, ...]) -> Optional[Tuple[float, ...]]:
        arr = np.asarray(v, dtype=float)
        if not np.all(np.isfinite(arr)):
            return None
        norm = float(np.linalg.norm(arr))
        return tuple((arr / norm).tolist()) if norm > 1e-9 else None

    def _angle(a: Tuple[float, ...], b: Tuple[float, ...]) -> float:
        ua, ub = _unit(a), _unit(b)
        if ua is None or ub is None:
            return 180.0          # undefined -> treat as clear (safe default for the Red Line)
        return float(np.degrees(np.arccos(float(np.clip(np.dot(ua, ub), -1.0, 1.0)))))

except ImportError:

    def _unit(v: Tuple[float, ...]) -> Optional[Tuple[float, ...]]:
        if not all(math.isfinite(x) for x in v):
            return None
        norm = math.sqrt(sum(x * x for x in v))
        return tuple(x / norm for x in v) if norm > 1e-9 else None

    def _angle(a: Tuple[float, ...], b: Tuple[float, ...]) -> float:
        ua, ub = _unit(a), _unit(b)
        if ua is None or ub is None:
            return 180.0
        dot = max(-1.0, min(1.0, sum(x * y for x, y in zip(ua, ub))))
        return math.degrees(math.acos(dot))


def _angle_from(device: Tuple[float, ...], a: Tuple[float, ...], b: Tuple[float, ...]) -> float:
    """Angular separation of points a and b AS SEEN FROM `device` (the vertex).
    Use whenever positions are not already vectors from the acting IoT, so the
    Red Line is measured at the actual emitter rather than at the frame origin.
    With device at the origin this equals _angle(a, b)."""
    va = tuple(x - y for x, y in zip(a, device))
    vb = tuple(x - y for x, y in zip(b, device))
    return _angle(va, vb)


