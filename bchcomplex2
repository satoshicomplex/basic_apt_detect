class Library:
    def __init__(self, max_samples_per_pathway: int = 500, retrain_every: int = 10) -> None:
        self.records: List[Dict[str, Any]] = []
        self.max_samples = max_samples_per_pathway
        self.retrain_every = retrain_every
        self.X: Dict[str, Deque[List[float]]] = {}
        self.y: Dict[str, Deque[int]] = {}
        self.sample_counts: Dict[str, int] = {}
        self.nets: Dict[str, Any] = {}
        self.earnings: Dict[str, int] = {"$BTC": 0, "$BCH": 0}
        self.credited: Dict[str, Dict[str, int]] = {}

    def _credit(self, iot: str, currency: str, n: int) -> None:
        self.earnings[currency] += n
        self.credited.setdefault(iot, {"$BTC": 0, "$BCH": 0})[currency] += n

    def record(self, fields: Dict[str, Any], from_iots: List[str]) -> int:
        safe = {k: v for k, v in fields.items() if k.lower() not in PROTECTED}
        self.records.append(safe)
        for io in from_iots or ["requesting_iot"]:
            self._credit(io, "$BTC", 1)
        return len(self.records)

    def learn(self, pathway: str, env_features: List[float], env_breached: bool, force_fit: bool = False) -> None:
        X = self.X.setdefault(pathway, deque(maxlen=self.max_samples))
        y = self.y.setdefault(pathway, deque(maxlen=self.max_samples))
        X.append([float(f) for f in env_features])
        y.append(int(env_breached))
        count = self.sample_counts.get(pathway, 0) + 1
        self.sample_counts[pathway] = count

        if (
            len(set(y)) == 2
            and len(y) >= 6
            and (force_fit or count % self.retrain_every == 0 or pathway not in self.nets)
        ):
            try:
                from sklearn.neural_network import MLPClassifier
                self.nets[pathway] = MLPClassifier((16,), max_iter=500, random_state=0).fit(list(X), list(y))
            except Exception:
                logger.info("library: neural net unavailable; environmental data retained")

    def predict(self, pathway: str, env_features: List[float], iot: str = "model_owner") -> Optional[float]:
        net = self.nets.get(pathway)
        if net is None:
            return None
        self._credit(iot, "$BCH", 1)
        try:
            return round(float(net.predict_proba([[float(f) for f in env_features]])[0, 1]), 3)
        except Exception:
            return None

    def monetization(self) -> Dict[str, Any]:
        return {
            "records": len(self.records),
            "trained_models": sorted(self.nets),
            "earnings": dict(self.earnings),
            "iots_credited": self.credited,
        }


