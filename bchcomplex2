# ---------------------------------------------------------------------------
# 4 · Personalize (hazard × this user's susceptibility)
# ---------------------------------------------------------------------------
def _p_infect(personal_ratio: float, k: float = INFECTION_K) -> float:
    """Estimated probability of infection for this user, from their personalized
    exposure. A saturating curve (0 at no exposure -> ~1 as it grows); the slope k
    is an input from a validated model, not an epidemiological constant invented
    here. This is an ESTIMATE, not a clinical probability."""
    return round(1.0 - math.exp(-max(0.0, float(k)) * max(0.0, personal_ratio)), 3)


def personalize(risk: Risk, susceptibility: Dict[str, float]) -> Risk:
    raw_mult = susceptibility.get(PATHWAY[risk.kind], susceptibility.get("overall", 1.0))
    if not _nums(raw_mult):
        raw_mult = 1.0
    mult = max(MIN_SUSCEPTIBILITY_FLOOR, min(MAX_SUSCEPTIBILITY_CAP, float(raw_mult)))
    risk.susceptibility = round(mult, 2)
    risk.personal_ratio = round(risk.env_ratio * mult, 2)
    pr = risk.personal_ratio
    risk.level = (
        "high" if pr >= 2.0 * AVOID_RATIO
        else "elevated" if pr >= AVOID_RATIO
        else "low" if pr >= 0.7 * AVOID_RATIO
        else "none"
    )
    risk.elevated = pr >= AVOID_RATIO
    k = susceptibility.get("infectivity_k", INFECTION_K)
    risk.infection_probability = _p_infect(pr, k if _nums(k) else INFECTION_K)

    # Personalized forecast: when does THIS user cross their avoid line?
    if risk.seconds_to_threshold is not None and mult > 0 and risk.env_ratio < AVOID_RATIO:
        # Scale remaining headroom by susceptibility
        remaining_ratio = max(0.0, AVOID_RATIO / mult - risk.env_ratio)
        if remaining_ratio > 0 and risk.seconds_to_threshold > 0:
            # Approximate proportional adjustment (conservative)
            risk.seconds_to_threshold = round(risk.seconds_to_threshold * (remaining_ratio / max(0.01, AVOID_RATIO - risk.env_ratio)), 1)
    return risk


