class RiskKind(str, Enum):
    AIR = "airborne pathogen / ventilation"
    SURFACE = "surface contamination"
    WATER = "water contamination"
    TRANSMISSION = "person-to-person transmission"
    HOME = "home hazard"


PATHWAY = {
    RiskKind.AIR: "airborne",
    RiskKind.SURFACE: "surface",
    RiskKind.WATER: "waterborne",
    RiskKind.TRANSMISSION: "transmission",
    RiskKind.HOME: "airborne",
}


@dataclass
class Risk:
    kind: RiskKind
    elevated: bool
    level: str  # none | low | elevated | high
    certainty: float
    env_ratio: float = 0.0
    personal_ratio: float = 0.0
    susceptibility: float = 1.0
    cause: str = ""
    source: str = ""
    seconds_to_threshold: Optional[float] = None
    iot_can_do: List[str] = field(default_factory=list)
    detail: str = ""
    valid_check: bool = True
    infection_probability: float = 0.0     # estimated P(infection) for THIS user
    env_features: List[float] = field(default_factory=list)


def _certainty(window_s: float, sensor_conf: float, corroborating: int) -> float:
    w = max(0.0, min(1.0, (window_s - MIN_WINDOW_S) / (MAX_WINDOW_S - MIN_WINDOW_S) + 0.4))
    c = max(0.0, min(1.0, sensor_conf))
    return round(min(1.0, 0.5 * w + 0.4 * c + 0.1 * min(2, max(0, corroborating))), 2)


def _forecast(value: float, limit: float, rate_per_s: Optional[float]) -> Optional[float]:
    if value >= limit:
        return 0.0
    if not rate_per_s or rate_per_s <= 0:
        return None
    return round((limit - value) / rate_per_s, 1)


def _nums(*xs) -> bool:
    return all(isinstance(x, (int, float)) and not isinstance(x, bool) for x in xs)


def _invalid(kind: RiskKind, why: str) -> Risk:
    return Risk(kind, False, "none", 0.0, detail=why, valid_check=False)


def _mk(
    kind: RiskKind,
    env_ratio: float,
    window_s: float,
    r: Dict[str, Any],
    cause: str,
    source: str,
    actions: List[str],
    detail: str,
    fc: Optional[float] = None,
    features: Optional[List[float]] = None,
) -> Risk:
    cert = _certainty(window_s, r.get("sensor_conf", 0.8), r.get("sources", 1))
    return Risk(
        kind,
        False,
        "none",
        cert,
        env_ratio=round(env_ratio, 2),
        cause=cause,
        source=source,
        seconds_to_threshold=fc,
        iot_can_do=actions,
        detail=detail,
        env_features=features or [round(env_ratio, 4), cert],
    )


def check_air(r: Dict[str, Any], window_s: float) -> Risk:
    load, limit = r.get("airborne_pathogen"), r.get("airborne_limit")
    if not _nums(load, limit) or limit <= 0 or load < 0:
        return _invalid(RiskKind.AIR, "missing/invalid air metrics")

    ach, min_ach = r.get("ach"), r.get("min_ach")
    poor_vent = _nums(ach, min_ach) and ach < min_ach
    bz = max(1.0, float(r.get("breathing_zone_factor", 1.0)))

    # Micro-conditions that concentrate risk at nose level
    temp_factor = 1.0
    if _nums(r.get("temp_c"), r.get("temp_ref_c")):
        # Cooler air can increase aerosol persistence in many indoor settings
        delta = r["temp_ref_c"] - r["temp_c"]
        temp_factor = 1.0 + max(0.0, min(0.4, delta * 0.05))

    wind_factor = 1.0
    if _nums(r.get("wind_ms")):
        # Low wind allows longer residence time of infectious aerosol
        wind_factor = 1.0 + max(0.0, min(0.5, (1.5 - r["wind_ms"]) * 0.2))

    vent_mult = 1.5 if poor_vent else 1.0
    eff = load * vent_mult * bz * temp_factor * wind_factor
    fc = _forecast(eff, limit, r.get("trend_per_s"))

    notes = []
    if poor_vent:
        notes.append("ventilation below minimum")
    if bz > 1.0:
        notes.append("air pooling at nose level")
    if temp_factor > 1.05:
        notes.append("temperature favoring persistence")
    if wind_factor > 1.05:
        notes.append("low air movement")

    return _mk(
        RiskKind.AIR,
        eff / limit,
        window_s,
        r,
        "device" if r.get("hvac_fault") else "facility",
        r.get("zone", "ward air"),
        [
            "boost filtration / fresh-air exchange",
            "raise ventilation",
            "limit occupancy",
            "alert facilities + HVAC maker",
        ],
        f"airborne {eff:.1f} vs limit {limit}" + (f" · {'; '.join(notes)}" if notes else ""),
        fc,
        features=[round(load / limit, 4), vent_mult, round(bz, 4), round(temp_factor, 4), round(wind_factor, 4)],
    )


def check_surface(r: Dict[str, Any], window_s: float) -> Risk:
    idx, thresh = r.get("contamination_index"), r.get("sanitize_threshold")
    if not _nums(idx, thresh) or thresh <= 0 or idx < 0:
        return _invalid(RiskKind.SURFACE, "missing/invalid surface metrics")
    ratio = idx / thresh
    return _mk(
        RiskKind.SURFACE,
        ratio,
        window_s,
        r,
        "device" if r.get("on_equipment") else "facility",
        r.get("surface", "surface"),
        [
            "flag for immediate sanitization",
            "take item / area out of use",
            "alert environmental services",
        ],
        f"surface index {idx} vs threshold {thresh} on {r.get('surface', 'surface')}",
        _forecast(idx, thresh, r.get("trend_per_s")),
        features=[round(ratio, 4), float(r.get("sources", 1))],
    )


def check_water(r: Dict[str, Any], window_s: float) -> Risk:
    metrics = ("coliform", "turbidity_ntu", "waterborne_pathogen")
    pairs = [
        (m, r[m], r[f"{m}_limit"])
        for m in metrics
        if m in r
        and f"{m}_limit" in r
        and _nums(r.get(m), r.get(f"{m}_limit"))
        and r[f"{m}_limit"] > 0
        and r[m] >= 0
    ]
    if not pairs:
        return _invalid(RiskKind.WATER, "no valid water metric/limit pairs")
    m, v, lim = max(pairs, key=lambda p: p[1] / p[2])
    breaches = [k for k, val, l in pairs if val > l]
    ratio = v / lim
    return _mk(
        RiskKind.WATER,
        ratio,
        window_s,
        r,
        "device" if r.get("treatment_fault") else "environmental",
        r.get("source", "water source"),
        [
            "issue a do-not-use / boil-water notice",
            "shut affected line / fixture",
            "alert water operator + public health",
        ],
        f"over limit: {', '.join(breaches) or m} at {r.get('source', 'the source')}",
        _forecast(v, lim, r.get("trend_per_s")),
        features=[round(ratio, 4), float(len(breaches))],
    )


def check_transmission(r: Dict[str, Any], window_s: float) -> Risk:
    density = r.get("density_per_m2", 0.0)
    d_limit = r.get("density_limit", float("inf"))
    if not isinstance(density, (int, float)) or density < 0 or d_limit <= 0:
        return _invalid(RiskKind.TRANSMISSION, "invalid density")
    d_ratio = density / d_limit if d_limit != float("inf") else 0.0
    case_flag = 1.0 if r.get("known_case_present") else 0.0
    vent_flag = 1.0 if r.get("poor_ventilation") else 0.0
    score = d_ratio + (0.8 * case_flag) + (0.5 * vent_flag)
    return _mk(
        RiskKind.TRANSMISSION,
        score,
        window_s,
        r,
        "facility",
        r.get("zone", "the area"),
        [
            "reduce occupancy / space people out",
            "boost ventilation",
            "mask / distance guidance",
            "clean high-touch points",
        ],
        f"crowding{' + known case' if case_flag else ''}{' + poor air' if vent_flag else ''} in {r.get('zone', 'the area')}",
        features=[round(d_ratio, 4), case_flag, vent_flag],
    )


def check_home_all(r: Dict[str, Any], window_s: float) -> List[Risk]:
    hazards = {
        "bathroom_contamination": (
            "unsanitary bathroom",
            ["deep-clean + disinfect the bathroom", "fix any leak / standing water", "improve exhaust ventilation"],
        ),
        "basement_mold": (
            "basement mold",
            ["dry the source + run a dehumidifier", "remediate the mold (seal / remove)", "fix water intrusion"],
        ),
        "damp_index": (
            "chronic damp",
            ["find and stop the moisture source", "ventilate + dehumidify", "inspect for hidden mold"],
        ),
    }
    found: List[Risk] = []
    for key, (label, fix) in hazards.items():
        v, lim = r.get(key), r.get(f"{key}_limit")
        if _nums(v, lim) and lim > 0 and v >= 0:
            ratio = v / lim
            item = _mk(
                RiskKind.HOME,
                ratio,
                window_s,
                r,
                "home",
                label,
                fix,
                f"{label}: {key} {v} vs limit {lim}",
                features=[round(ratio, 4)],
            )
            found.append(item)
    if not found:
        return [_invalid(RiskKind.HOME, "no valid home hazard metric/limit pairs")]
    return found


