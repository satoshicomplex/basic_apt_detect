def comms_broadcast(
    nearby_iots: List[Dict[str, Any]], elevated: List[Risk], place: Place, emergency: bool
) -> List[Dict[str, Any]]:
    head = (
        "EMERGENCY: a real exposure risk right now"
        if emergency
        else "CONFIRMATION: elevated risk detected at this place"
    )
    msgs = []
    for io in nearby_iots:
        caps = [str(c).lower() for c in io.get("can_help_with", [])]
        wanted = [r for r in elevated if r.kind.name.lower() in caps or "any" in caps]
        if not wanted:
            continue
        msgs.append({
            "to": io.get("name", "unknown_iot"),
            "header": head,
            "location": place.public_id(),
            "about": [r.kind.value for r in wanted],
            "we_ask": sorted({a for r in wanted for a in r.iot_can_do}),
            "you_earn": "$BTC for data shared · $BCH for a neural-net run",
        })
    return msgs


def ask_nearby(nearby_iots: List[Dict[str, Any]], risk: Risk) -> List[Dict[str, Any]]:
    target = risk.kind.name.lower()
    out = []
    for io in nearby_iots:
        caps = [str(c).lower() for c in io.get("can_help_with", [])]
        if target in caps or "any" in caps:
            out.append({
                "iot": io.get("name", "unknown_iot"),
                "request": "help prevent this exposure",
                "provided": {"data": "$BTC data units", "neural_net": "$BCH NN units"},
                "earns": True,
            })
    return out


def escalate(risk: Risk, venue: Dict[str, Any], prevention: str, event_id: str) -> Optional[Dict[str, Any]]:
    if not risk.elevated:
        return None
    if risk.cause == "device":
        to, level = venue.get("device_makers", {}).get(risk.source, "the device maker"), "device maker"
    elif risk.cause == "environmental":
        to, level = venue.get("water_operator", "the water operator"), "water operator / utility"
    elif risk.cause == "home":
        to, level = "the requesting IoT / resident", "household"
    else:
        to, level = venue.get("name", "the facility operator"), "facility operator"
    return {
        "event_id": event_id,
        "to": to,
        "level": level,
        "about": risk.kind.value,
        "level_of_risk": risk.level,
        "source": risk.source,
        "prevention": prevention,
        "contains_protected_data": False,
    }


def notify_public_health(
    risks: List[Risk], place: Place, venue: Dict[str, Any], storable: Dict[str, Any], event_id: str
) -> Optional[Dict[str, Any]]:
    public = [
        r for r in risks
        if r.elevated and r.cause != "home" and (r.level == "high" or r.kind in (RiskKind.WATER, RiskKind.AIR))
    ]
    if not public:
        return None
    return {
        "event_id": event_id,
        "command_center": "BCH Complex Real-Time Command",
        "to": [venue.get("name", "the operator"), "public health"],
        "about": [r.kind.value for r in public],
        "location": place.public_id(),
        "location_kind": place.kind,
        "lawful_payload": storable,
        "protected_data_withheld": True,
    }


