    req: Dict[str, Any],
    place: Place,
    data: Dict[str, Any],
    nearby_iots: Optional[List[Dict[str, Any]]] = None,
    venue: Optional[Dict[str, Any]] = None,
    library: Optional[Library] = None,
) -> Dict[str, Any]:
    t0 = time.perf_counter()
    def ms() -> float:
        return round((time.perf_counter() - t0) * 1000, 2)

    event_id = str(uuid.uuid4())
    timestamp_utc = datetime.now(timezone.utc).isoformat()
    nearby_iots = nearby_iots or []
    venue = venue or {}
    library = library if library is not None else LIBRARY
    from_iots = req.get("data_from_iots", [])
    working = copy.deepcopy(data)

    receipt: Optional[Dict[str, Any]] = None
    storable: Dict[str, Any] = {}
    earners: List[str] = []
    billed = 0

    out: Dict[str, Any] = {
        "event_id": event_id,
        "timestamp_utc": timestamp_utc,
        "location": place.public_id(),
        "location_kind": place.kind,
        "time_requested": req.get("time", timestamp_utc),
    }

    try:
        receipt, status, authorized = admit(acct, req)
        if not authorized:
            out.update({"status": status, "receipt": receipt, "latency_ms": ms()})
            return out

        try:
            window_s = float(req.get("window_s", 0.5))
        except (TypeError, ValueError):
            window_s = 0.5

        if window_s < MIN_WINDOW_S:
            out.update({"status": "NEED_MORE_DATA", "need_at_least_s": MIN_WINDOW_S, "latency_ms": ms()})
            return out
        window_s = min(window_s, MAX_WINDOW_S)

        controlled = req.get("controlled_activity") in LEGIT_CONTROLLED
        susceptibility = working.get("susceptibility", {}) if isinstance(working.get("susceptibility"), dict) else {}

        risks: List[Risk] = []
        single_detectors = (
            ("air", check_air),
            ("surface", check_surface),
            ("water", check_water),
            ("transmission", check_transmission),
        )
        for key, fn in single_detectors:
            if key not in working:
                continue
            block = working[key]
            if not isinstance(block, dict):
                risks.append(_invalid(RiskKind.AIR, f"{key}: expected an object"))
                continue
            r = fn(block, window_s)
            if r.valid_check:
                personalize(r, susceptibility)
            risks.append(r)

        if "home" in working:
            block = working["home"]
            if not isinstance(block, dict):
                risks.append(_invalid(RiskKind.HOME, "home: expected an object"))
            else:
                for hr in check_home_all(block, window_s):
                    if hr.valid_check:
                        personalize(hr, susceptibility)
                    risks.append(hr)

        valid = [r for r in risks if r.valid_check]
        if not valid:
            out.update({
                "status": "INSUFFICIENT_OR_INVALID_DATA",
                "confirmed_safe": False,
                "billed_units": 0,
                "latency_ms": ms(),
            })
            return out

        elevated = [] if controlled else [r for r in valid if r.elevated]
        home_hazards = [r for r in elevated if r.cause == "home"]
        away_hazards = [r for r in elevated if r.cause != "home"]

        raw_storable = {
            "event_id": event_id,
            "timestamp_utc": timestamp_utc,
            "location_kind": place.kind,
            "risk_kinds": [r.kind.value for r in elevated],
            "levels": [r.level for r in elevated],
            "device_models": sorted({r.source for r in elevated if r.cause == "device" and r.source}),
            "window_s": window_s,
        }
        storable = for_storage(raw_storable, list(raw_storable.keys()))

        library.record(storable, from_iots)
        model_check = {}
        for r in valid:
            pathway_key = f"{place.kind}:{PATHWAY[r.kind]}"
            env_breached = r.env_ratio >= AVOID_RATIO
            library.learn(pathway_key, r.env_features, env_breached)
            p = library.predict(pathway_key, r.env_features)
            if p is not None:
                model_check[r.kind.value] = p

        comms = comms_broadcast(nearby_iots, away_hazards, place, bool(req.get("emergency")))
        help_requests = [{"risk": r.kind.value, "asked": ask_nearby(nearby_iots, r)} for r in away_hazards]
        earners = sorted({a["iot"] for h in help_requests for a in h["asked"]})
        reports = [x for x in (escalate(r, venue, PREVENTION[r.kind], event_id) for r in elevated) if x]
        public_health = notify_public_health(elevated, place, venue, storable, event_id)

        verified = verify_emergency(req, valid)
        billed = acct.settle(1 + len(earners), 2 * max(1, len(elevated)), True, verified)
        certainty = min((r.certainty for r in valid), default=0.0)
        # overall probability of infection for this user: chance ANY route infects.
        # recognized controlled activity is contained, so it carries ~0 probability.
        p_each = [] if controlled else [r.infection_probability for r in valid]
        p_infection = round(1.0 - math.prod(1.0 - p for p in p_each), 3) if p_each else 0.0

        if home_hazards and not away_hazards:
            recommendation = "FIX_HOME"
        elif away_hazards:
            recommendation = "DO_NOT_GO"
        else:
            recommendation = "SAFE_TO_GO"

        out.update({
            "status": "OK",
            "recommendation": recommendation,
            "certainty_percent": round(100 * certainty),
            "probability_of_infection": p_infection,
            "probability_of_infection_percent": round(100 * p_infection),
            "recognized_controlled_activity": controlled,
            "library_corroboration": model_check or None,
            "library_monetization": library.monetization(),
        })

        if recommendation == "SAFE_TO_GO":
            fts = [r.seconds_to_threshold for r in valid if r.seconds_to_threshold not in (None, 0.0)]
            out.update({
                "confirmed_safe": True,
                "safe_until_s": min(fts) if fts else None,
                "checks_run": [r.kind.value for r in valid],
                "message": f"no problem detected at {place.public_id()} for this user; "
                           f"probability of infection {round(100 * p_infection)}%, certainty {round(100 * certainty)}%",
            })
        else:
            out.update({
                "confirmed_safe": False,
                "risks": [
                    {
                        "kind": r.kind.value,
                        "level": r.level,
                        "certainty": r.certainty,
                        "env_ratio": r.env_ratio,
                        "your_susceptibility": r.susceptibility,
                        "personal_ratio": r.personal_ratio,
                        "probability_of_infection": r.infection_probability,
                        "cause": r.cause,
                        "source": r.source,
                        "seconds_to_threshold": r.seconds_to_threshold,
                        "iot_can_do": r.iot_can_do,
                        "detail": r.detail,
                    }
                    for r in elevated
                ],
                "home_fix": [{"hazard": r.source, "level": r.level, "fix": r.iot_can_do} for r in home_hazards] or None,
                "comms_to_nearby_iots": comms,
                "nearby_iots_asked_to_help": help_requests,
                "reports_up_the_chain": reports,
                "public_health_notified": public_health,
                "message": (
                    "avoid this place at this time" if recommendation == "DO_NOT_GO" else "fix the home hazard(s)"
                ) + f" · probability of infection {round(100 * p_infection)}% · certainty {round(100 * certainty)}%",
            })

        logger.info(
            "infection respond event=%s iot=%s loc=%s rec=%s elevated=%d billed=%d %.2fms",
            event_id, acct.iot_id, place.public_id(), recommendation, len(elevated), billed, ms(),
        )
        return out

    except Exception as exc:
        logger.exception("infection respond fallback event=%s iot=%s", event_id, acct.iot_id)
        out.update({"status": "FAILED_SAFE", "reason": type(exc).__name__, "confirmed_safe": False, "billed_units": 0})
        return out

    finally:
        protected_seen = extract_and_purge_protected(working)
        out.update({
            "receipt": receipt,
            "stored_monetizable": storable,
            "protected_used_not_stored": protected_seen,
            "iots_earning": earners,
            "billed_units": billed,
            "latency_ms": ms(),
        })


