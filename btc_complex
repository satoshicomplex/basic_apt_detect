def write_audit(event: Dict[str, Any]) -> None:
    try:
        with AUDIT_FILE.open("a") as f:
            f.write(json.dumps(event) + "\n")
    except Exception:
        pass


# ---------------------------------------------------------------------------
# 7 · Main orchestrator
# ---------------------------------------------------------------------------
def respond(
    acct: Account,
    req: Dict[str, Any],
    data: Dict[str, Any],
    library: Optional[HousingLibrary] = None,
    today: Optional[str] = None,
    hold_slot: bool = True,
) -> Dict[str, Any]:
    t0 = time.perf_counter()

    def ms() -> float:
        return round((time.perf_counter() - t0) * 1000, 2)

    event_id = str(uuid.uuid4())
    today = today or date.today().isoformat()
    library = library if library is not None else LIBRARY
    working = copy.deepcopy(data)
    out: Dict[str, Any] = {"event_id": event_id, "timestamp_utc": datetime.now(timezone.utc).isoformat()}
    billing: Dict[str, Any] = {}
    protected_seen: List[str] = []

    try:
        pd_raw = working.get("person") if isinstance(working.get("person"), dict) else {}
        raw_identity = working.get("identity") or pd_raw.get("id") or pd_raw.get("person_id")
        token = obfuscate(raw_identity) if raw_identity else obfuscate(event_id)
        protected_seen = extract_and_purge_protected(working)

        _, mode, authorized = admit(req)
        if not authorized:
            out.update({"status": "DECLINED", "reason": "no consent / waiver"})
            write_audit(out)
            return out

        pd = working.get("person", {}) if isinstance(working.get("person"), dict) else {}
        person = Person(
            match_token=token,
            area=str(pd.get("area", "")).strip()[:64],
            household_size=max(1, min(12, int(pd.get("household_size", 1)))),
            income_capacity_usd=max(0.0, float(pd.get("income_capacity_usd", 0.0))),
            employable=bool(pd.get("employable", True)),
            needs=list(pd.get("needs", []))[:20],
            cannot=list(pd.get("cannot", []))[:20],
            safety_needs=list(pd.get("safety_needs", []))[:20],
            min_safety=_clamp(pd.get("min_safety", 0.6)),
        )

        options = library.available_today(today)
        if not options:
            billing = acct.settle(mode, succeeded=False)
            out.update({
                "status": "NO_LISTINGS_TODAY",
                "message": "no housing data submitted for today yet; the library updates daily",
                "billing": billing,
            })
            write_audit(out)
            return out

        iot_safety = working.get("safety", {}) if isinstance(working.get("safety"), dict) else {}
        ranked = match(person, options, iot_safety)["ranked"]

        chosen: Optional[Tuple[Housing, float, str]] = None
        hold_expires: Optional[str] = None
        for candidate, score, why in ranked:
            if not hold_slot:
                chosen = (candidate, score, why)
                break
            exp = library.reserve_slot(candidate.id, token)
            if exp:
                chosen = (candidate, score, why)
                hold_expires = exp
                break

        succeeded = chosen is not None
        billing = acct.settle(mode, succeeded)

        req_iot = req.get("iot_id", acct.iot_id)
        earners: Dict[str, Dict[str, int]] = {}
        if chosen:
            best, best_score, why = chosen
            earners[req_iot] = {"$BTC": 1}
            if best.provider:
                earners.setdefault(best.provider, {"$BTC": 0})["$BTC"] += 1

            alts = [
                {"id": o.id, "kind": o.kind, "where": o.where, "score": s, "why": w}
                for o, s, w in ranked if o.id != best.id
            ][:3]

            out.update({
                "status": "MATCH",
                "confirmed_home": True,
                "best_option": {
                    "id": best.id,
                    "kind": best.kind,
                    "where": best.where,
                    "monthly_cost_usd": best.monthly_cost_usd,
                    "safety_rating": best.safety_rating,
                    "prosperity_score": best.prosperity_score,
                    "provider": best.provider,
                    "match_score": best_score,
                    "why": why,
                    "slot_held_until_utc": hold_expires,
                },
                "alternatives": alts,
                "get_person_there": [
                    "share the offer + directions with the person via the requesting IoT",
                    "present the match_token / hold before slot_held_until_utc",
                    "arrange transport if available",
                ],
                "next_steps_to_a_proper_home": next_steps(person, best),
            })
        else:
            out.update({
                "status": "NO_MATCH_TODAY",
                "confirmed_home": False,
                "message": "no safe, affordable real-home option fits today. Re-check as the library updates.",
                "alternatives_considered": len(options),
            })

        out.update({"billing": billing, "iots_earning": earners, "library": library.monetization()})
        logger.info("homeless respond event=%s iot=%s matched=%s %.2fms", event_id, acct.iot_id, succeeded, ms())
        write_audit(out)
        return out

    except Exception as exc:
        logger.exception("homeless respond fallback event=%s", event_id)
        out.update({"status": "FAILED_SAFE", "reason": type(exc).__name__, "billing": billing or {}})
        write_audit(out)
        return out

    finally:
        extra_purged = extract_and_purge_protected(working)
        all_purged = sorted(set(protected_seen) | set(extra_purged))
        out.update({
            "protected_used_not_stored": all_purged,
            "identity_handling": "obfuscated in real time; raw value purged immediately",
            "latency_ms": ms(),
        })


