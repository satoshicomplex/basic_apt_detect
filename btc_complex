@dataclass
class Account:
    iot_id: str
    credits_usd: float = 0.0
    owed_usd: float = 0.0
    charged_usd: float = 0.0
    max_credit_limit_usd: float = 10.0

    def settle(self, mode: str, succeeded: bool) -> Dict[str, Any]:
        if not succeeded:
            return {"charged_usd": 0.0, "mode": "none (no match, not charged)"}
        if mode == "free":
            return {"charged_usd": 0.0, "mode": "free"}
        if mode == "credit":
            if self.owed_usd + MICRO_USD > self.max_credit_limit_usd:
                return {"charged_usd": 0.0, "mode": "free (credit cap reached, waived)"}
            self.owed_usd = round(self.owed_usd + MICRO_USD, 4)
            return {"charged_usd": 0.0, "owed_usd": self.owed_usd, "mode": "credit"}
        if self.credits_usd < MICRO_USD:
            return {"charged_usd": 0.0, "mode": "free (insufficient micro-balance, waived)"}
        self.credits_usd = round(self.credits_usd - MICRO_USD, 4)
        self.charged_usd = round(self.charged_usd + MICRO_USD, 4)
        return {"charged_usd": MICRO_USD, "mode": "micro-payment"}


def _key() -> bytes:
    env = os.environ.get("BTCC_DEVICE_KEY")
    return env.encode() if env else _FALLBACK_KEY


def verify_iot_signature(req: Dict[str, Any], secret: Optional[bytes] = None) -> bool:
    sig = req.get("sig")
    if not sig:
        return True
    key = secret or _key()
    msg = f"{req.get('iot_id', '')}:{req.get('nonce', '')}:{req.get('pay', 'free')}".encode()
    expected = hmac.new(key, msg, hashlib.sha256).hexdigest()
    return hmac.compare_digest(str(sig), expected)


def admit(req: Dict[str, Any], require_sig: bool = False) -> Tuple[Optional[Dict[str, Any]], str, bool]:
    if not req.get("consent"):
        return None, "DECLINED: no consent / waiver", False
    if require_sig and not req.get("sig"):
        return None, "DECLINED: missing IoT signature", False
    if not verify_iot_signature(req):
        return None, "DECLINED: invalid IoT signature", False
    mode = req.get("pay", "free")
    if mode not in ("micro", "credit", "free"):
        mode = "free"
    return {
        "offer": mode,
        "cost_usd": 0.0 if mode != "micro" else MICRO_USD,
        "note": "any proximate IoT may request; sub-$0.10, credit, or free (simulated)",
    }, mode, True


