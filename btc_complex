# 2 · Privacy
# ---------------------------------------------------------------------------
PROTECTED: Set[str] = {
    "name", "first_name", "last_name", "dob", "birth_date", "ssn", "address", "street",
    "phone", "email", "face", "photo", "mrn", "diagnosis", "health_status", "genetic",
    "biometric_hash", "phi", "pii", "person_id", "immigration_status", "criminal_history",
}


def obfuscate(value: Any) -> str:
    return "anon-" + hmac.new(_key(), str(value).encode(), hashlib.sha256).hexdigest()[:16]


def extract_and_purge_protected(payload: Any, found: Optional[Set[str]] = None) -> List[str]:
    if found is None:
        found = set()
    if isinstance(payload, dict):
        for k in list(payload.keys()):
            if k.lower() in PROTECTED:
                found.add(k)
                payload[k] = None
                del payload[k]
            else:
                extract_and_purge_protected(payload[k], found)
    elif isinstance(payload, list):
        for item in payload:
            extract_and_purge_protected(item, found)
    return sorted(found)


# ---------------------------------------------------------------------------
# 3 · Housing Library (thread-safe, persistent, atomic holds)
# ---------------------------------------------------------------------------
def _clamp(val: float, lo: float = 0.0, hi: float = 1.0) -> float:
    try:
        return max(lo, min(hi, float(val)))
    except (TypeError, ValueError):
        return lo


@dataclass
class Housing:
    id: str
    kind: str
    where: str
    monthly_cost_usd: float
    slots: int
    safety_rating: float
    prosperity_score: float
    requirements: List[str] = field(default_factory=list)
    amenities: List[str] = field(default_factory=list)
    max_occupancy: int = 1
    provider: str = ""
    updated: str = ""
    accessible: bool = True

    def validate(self) -> bool:
        return (
            bool(self.id) and self.kind not in EXCLUDED_KINDS
            and self.slots >= 0 and self.monthly_cost_usd >= 0
            and 0 <= self.safety_rating <= 1 and 0 <= self.prosperity_score <= 1
        )


class HousingLibrary:
    def __init__(self, hold_ttl_sec: int = 900) -> None:
        self._lock = threading.Lock()
        self.options: Dict[str, Housing] = {}
        self.holds: Dict[str, List[Tuple[str, float]]] = {}
        self.earnings: Dict[str, Dict[str, int]] = {}
        self.hold_ttl_sec = hold_ttl_sec
        self.load()

    def load(self) -> None:
        if not LIBRARY_FILE.exists():
            return
        try:
            raw = json.loads(LIBRARY_FILE.read_text())
            for item in raw.get("options", []):
                h = Housing(**item)
                if h.validate():
                    self.options[h.id] = h
            self.earnings = raw.get("earnings", {})
        except Exception as e:
            logger.warning("Could not load library: %s", e)

    def save(self) -> None:
        with self._lock:
            data = {
                "options": [asdict(o) for o in self.options.values()],
                "earnings": self.earnings,
                "saved_utc": datetime.now(timezone.utc).isoformat(),
            }
            LIBRARY_FILE.write_text(json.dumps(data, indent=2))

    def _prune_expired_holds(self, housing_id: str, now: float) -> None:
        active = [(tok, exp) for tok, exp in self.holds.get(housing_id, []) if exp > now]
        if active:
            self.holds[housing_id] = active
        else:
            self.holds.pop(housing_id, None)

    def effective_slots(self, housing_id: str, now: Optional[float] = None) -> int:
        now = now or time.time()
        o = self.options.get(housing_id)
        if not o:
            return 0
        self._prune_expired_holds(housing_id, now)
        held = len(self.holds.get(housing_id, []))
        return max(0, o.slots - held)

    def reserve_slot(self, housing_id: str, match_token: str) -> Optional[str]:
        now = time.time()
        with self._lock:
            if self.effective_slots(housing_id, now) <= 0:
                return None
            expires = now + self.hold_ttl_sec
            self.holds.setdefault(housing_id, []).append((match_token, expires))
            return datetime.fromtimestamp(expires, tz=timezone.utc).isoformat()

    def submit(self, options: List[Housing], provider_iot: str, today: str) -> int:
        n = 0
        with self._lock:
            for o in options:
                if not o.validate():
                    continue
                o.safety_rating = _clamp(o.safety_rating)
                o.prosperity_score = _clamp(o.prosperity_score)
                o.max_occupancy = max(1, int(o.max_occupancy))
                o.updated = o.updated or today
                self.options[o.id] = o
                n += 1
            if n:
                self.earnings.setdefault(provider_iot, {"$BTC": 0, "$BCH": 0})["$BTC"] += n
        if n:
            self.save()
        return n

    def available_today(self, today: str) -> List[Housing]:
        now = time.time()
        with self._lock:
            return [
                o for o in self.options.values()
                if o.updated == today
                and o.kind not in EXCLUDED_KINDS
                and self.effective_slots(o.id, now) > 0
            ]

    def monetization(self) -> Dict[str, Any]:
        with self._lock:
            return {"listings": len(self.options), "providers_earning": copy.deepcopy(self.earnings)}


LIBRARY = HousingLibrary()


# ---------------------------------------------------------------------------
# 4 · Person + Matching
# ---------------------------------------------------------------------------
@dataclass
class Person:
    match_token: str
    area: str = ""
    household_size: int = 1
    income_capacity_usd: float = 0.0
    employable: bool = True
    needs: List[str] = field(default_factory=list)
    cannot: List[str] = field(default_factory=list)
    safety_needs: List[str] = field(default_factory=list)
    min_safety: float = 0.6


def _affordable(p: Person, o: Housing) -> bool:
    return (
        o.monthly_cost_usd == 0.0
        or o.monthly_cost_usd <= p.income_capacity_usd
        or o.kind == "job_with_housing"
    )


def _eligible(p: Person, o: Housing) -> bool:
    if o.slots <= 0 or not _affordable(p, o):
        return False
    if p.household_size > o.max_occupancy:
        return False
    if any(req in p.cannot for req in o.requirements):
        return False
    if "ground_floor" in p.needs and not o.accessible:
        return False
    if "allows_pets" in p.needs and "no_pets" in o.requirements:
        return False
    if not p.employable and o.kind == "job_with_housing":
        return False
    return True


def _score(p: Person, o: Housing) -> Tuple[float, str]:
    safety = o.safety_rating
    prosperity = o.prosperity_score
    fit = 1.0 if o.monthly_cost_usd == 0 else max(0.0, 1.0 - o.monthly_cost_usd / (p.income_capacity_usd + 1e-6))
    local = 1.0 if (p.area and o.where == p.area) else 0.65
    soft_needs = [n for n in p.needs if n not in ("ground_floor", "allows_pets")]
    need_fit = (sum(1 for n in soft_needs if n in o.amenities) / len(soft_needs)) if soft_needs else 1.0

    score = round(0.42 * safety + 0.33 * prosperity + 0.10 * min(1.0, fit) + 0.08 * local + 0.07 * need_fit, 3)
    why = (
        f"safety {safety:.2f} · prosperity {prosperity:.2f} · cost-fit {fit:.2f} · "
        f"local {local:.2f} · needs {need_fit:.2f}"
    )
    return score, why


def safety_ok(p: Person, o: Housing, iot_safety: Dict[str, Any]) -> Tuple[bool, List[str]]:
    reasons = []
    if o.safety_rating < p.min_safety:
        reasons.append("place below the person's safety minimum")
    for need in p.safety_needs:
        if need.startswith("away_from_") and o.where == need.replace("away_from_", ""):
            reasons.append(f"place is {need.replace('_', ' ')}")
    if iot_safety.get("needs_supervised_setting"):
        is_supervised = "supervised" in o.amenities or "supervised" in o.requirements
        if o.kind in ("trailer", "tiny_home") and not is_supervised:
            reasons.append("person needs a supported setting; this one is unsupervised")
    if iot_safety.get("placement_risk_flag"):
        reasons.append("requesting IoT flagged a placement-safety concern to review first")
    return (len(reasons) == 0), reasons


def match(p: Person, options: List[Housing], iot_safety: Dict[str, Any]) -> Dict[str, Any]:
    ranked = []
    for o in options:
        if not _eligible(p, o):
            continue
        safe, _ = safety_ok(p, o, iot_safety)
        if not safe:
            continue
        score, why = _score(p, o)
        ranked.append((o, score, why))
    ranked.sort(key=lambda x: (-x[1], -x[0].safety_rating, -x[0].prosperity_score))
    return {"ranked": ranked}


