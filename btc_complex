def next_steps(p: Person, o: Housing) -> List[Dict[str, str]]:
    steps = [
        {"iot": "benefits / ID helper", "do": "enroll any benefits + replace lost ID at the new address"},
        {"iot": "budget assistant", "do": "set up a simple budget + a savings target toward a lease deposit"},
        {"iot": "community / health navigator", "do": "connect to local services and a check-in cadence"},
    ]
    if p.employable and o.kind != "job_with_housing":
        steps.append({"iot": "local jobs board", "do": "match to nearby jobs reachable from this home"})
    if o.kind == "job_with_housing":
        steps.append({"iot": "employer onboarding", "do": "confirm the role + the housing terms in writing"})
    if "near_transit" in p.needs:
        steps.append({"iot": "transit planner", "do": "show routes and schedules from the new address"})
    return steps


